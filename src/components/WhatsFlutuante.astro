<style>
	.whats-flutuante {
		position: fixed;
		right: 16px;
		bottom: 16px;
		width: 60px;
		height: 60px;
		border-radius: 50%;
		background: var(--whats);
		color: #06210f;
		display: grid;
		place-items: center;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
		z-index: 50;
	}
	@media (min-width: 768px) {
		.whats-flutuante {
			display: none;
