---
import { EMPRESA, CONTATO } from "../data/site.mjs";
---

<header class="hero">
	<div class="wrap hero-grade">
		<div>
			<span class="rotulo">G-TECH System · {EMPRESA.cidade}</span>
			<h1>Software e automação do chão de fábrica à sua casa</h1>
			<p class="lead">
				Instrumentação, automação industrial, sistemas sob medida e robôs com IA. {EMPRESA.atendimento}.
			</p>
			<div class="acoes">
				<a class="btn btn-whats" href={CONTATO.whatsappLink} target="_blank" rel="noopener">Pedir orçamento no WhatsApp</a>
				<a class="btn" href="#servicos">Ver o que fazemos</a>
			</div>
		</div>
		<div class="selo">
			<img src="/logo-340.webp" srcset="/logo-340.webp 340w, /logo-680.webp 680w" sizes="(min-width: 860px) 320px, 240px" alt="G-TECH System" width="320" height="320" fetchpriority="high" />
		</div>
	</div>
</header>

<style>
	.hero {
		padding-block: clamp(48px, 10vw, 120px) clamp(40px, 8vw, 96px);
		background:
			radial-gradient(circle at 85% 10%, rgba(20, 109, 117, 0.35), transparent 55%),
			radial-gradient(circle at 5% 95%, rgba(6, 160, 210, 0.18), transparent 50%);
	}
	.hero-grade {
		display: grid;
		gap: 40px;
		align-items: center;
		grid-template-columns: 1fr;
	}
	.selo {
		justify-self: center;
		max-width: 260px;
		background: #f4f7f9;
		border-radius: 28px;
		padding: 10px;
		box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
	}
	.selo img {
		border-radius: 20px;
	}
	@media (min-width: 860px) {
		.hero-grade {
			grid-template-columns: 1.4fr 1fr;
		}
		.selo {
			max-width: 340px;
		}
	}
</style>
